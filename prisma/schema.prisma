generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Place {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?
  station     String
  openTime    String?
  travelInfo  String?
  phone       String?
  mapUrl      String?
  imageUrl    String?

  facebook    String?
  line        String?
  instagram   String?
  website     String?

  createdAt   DateTime @default(now())

  images PlaceImage[]
  events Event[]
  reviews Review[]
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  author    String?
  createdAt DateTime @default(now())

  placeId String
  place   Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
}


model PlaceImage {
  id        String   @id @default(cuid())
  url       String
  placeId  String
  place    Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}


model Event {
  id          String  @id @default(cuid())
  title       String
  description String?

  startDate DateTime
  endDate   DateTime

  stationCode String

  placeId String
  place   Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  sourceType EventSourceType
  sourceName String
  sourceUrl  String
  externalId String?

  imageUrl    String?
  images      EventImage[]

  status    EventStatus @default(DRAFT)
  createdAt DateTime    @default(now())
}

model EventImage {
  id        String   @id @default(cuid())
  url       String
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REJECTED
}

enum EventSourceType {
  INTERNAL
  EXTERNAL
}